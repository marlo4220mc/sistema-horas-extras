@startuml flujo_aprobacion
title Flujo: aprobar o rechazar una solicitud (Python)

start
:Ingresar id de la solicitud;
:Buscar solicitud en list[Solicitud];
if (Existe la solicitud?) then (si)
  if (Estado actual = PENDIENTE?) then (si)
    :Ingresar codigo de quien aprueba;
    :Buscar al empleado en list[Empleado];
    if (Es un Supervisor?) then (si)
    if (Decision?) then (aprobar)
      :Cambiar estado a APROBADA;
    else (rechazar)
      :Ingresar motivo;
      :Cambiar estado a RECHAZADA;
    endif
    :Registrar codigo del supervisor y fecha;
    :Mostrar confirmacion;
    else (no)
      :Lanzar AprobacionNoAutorizadaError\n(solo un supervisor aprueba);
    endif
  else (no)
    :Lanzar EstadoSolicitudInvalidaError\n(no se puede procesar dos veces);
  endif
else (no)
  :Lanzar SolicitudNoEncontradaError;
endif
stop

@enduml
